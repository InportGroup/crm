# Copy to .env.local and fill in with your own values.
# Supabase dashboard -> Project Settings -> Data API / API Keys
#
# Both values are PUBLIC. They end up in the JavaScript bundle that GitHub Pages
# serves, so anyone can read them. That is fine and expected: the anon key only
# grants what your Row Level Security policies allow.
# Never put the `service_role` key in here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
